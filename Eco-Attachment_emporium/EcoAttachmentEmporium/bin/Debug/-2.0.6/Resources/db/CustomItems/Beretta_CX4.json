    "locales": {
      "en": {
        "name": "Beretta Cx4 Storm 9x19 Carbine",
        "shortName": "Cx4 Storm",
        "description": "The Beretta Cx4 Storm is a semi-automatic pistol-calibre carbine aimed at the sporting, personal defense and law enforcement markets. It was designed to accept magazines from different Beretta pistol platforms (92/96, 8000 \"Cougar\" series, Px4) using adapters. The CX4 is available in 9×19mm Parabellum, .40 S&W, .45 ACP, and 9×21mm models."
      }
